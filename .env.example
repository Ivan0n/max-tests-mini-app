# PostgreSQL credentials. Set your own password before starting Compose.
DB_NAME=max_tests
DB_LOGIN=max_tests
DB_PASS=replace-with-a-long-random-password

# Used when running Python locally. Compose always connects to db:5432.
DB_IP=localhost
DB_PORT=5432

APP_PORT=8000
BACKEND_IMAGE=ivan0n/max-test-mini-app-backend:latest

# Frontend origins allowed to read API responses in a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# MAX bot token: set only on the backend. Login returns 503 until configured.
MAX_BOT_TOKEN=
# Optional: also start the text bot with regular docker compose up commands.
# COMPOSE_PROFILES=bot
# Maximum age of MAX init_data and lifetime of our session, in seconds.
MAX_INIT_DATA_MAX_AGE=3600
AUTH_SESSION_TTL=86400
# Closed beta: MAX user IDs (user.id from window.WebApp.initData), comma-separated.
# Empty = the service is open to every MAX user. Example: BETA_USER_IDS=987654321,123456789
BETA_USER_IDS=
# Public origin of the site (no path). Share links become <PUBLIC_URL>/test/<code>: a page with
# a test preview for the chat that opens the mini app. Empty = share the raw max.ru deep link.
PUBLIC_URL=

# Task images: the s3 service in compose.yaml (SeaweedFS). Use long random values, for example
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# S3_ACCESS_KEY / S3_SECRET_KEY are set once: the storage keeps using the first values it started with.
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=test-images
# Signs image links (/api/images/<id>?exp=...&sig=...). Changing it invalidates links already handed out.
IMAGE_SIGNING_KEY=replace-with-a-long-random-signing-key
