# PostgreSQL credentials. Set your own password before starting Compose.
DB_NAME=max_tests
DB_LOGIN=max_tests
# Only MAX_BOT_TOKEN is needed to start. DB_PASS, S3_* and IMAGE_SIGNING_KEY have defaults (the database
# and the storage are not reachable from outside Docker). On a public server set random values BEFORE
# the first start; `python scripts/configure.py` generates them.
# DB_PASS=replace-with-a-long-random-password

# Used when running Python locally. Compose always connects to db:5432.
DB_IP=localhost
DB_PORT=5432

APP_PORT=8000
# Backend image: pulled from Docker Hub. For your own build use `docker compose up -d --build`
# (then set BACKEND_IMAGE=max-test-mini-app-backend:latest) or an image loaded with `docker load -i`.
BACKEND_IMAGE=ivan0n/max-test-mini-app-backend:latest

# Frontend origins allowed to read API responses in a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# MAX bot token: set only on the backend. Login returns 503 until configured.
MAX_BOT_TOKEN=
# Optional bot settings. By default the backend asks MAX itself (GET /me) on start.
#   MAX_BOT_USERNAME — username for links https://max.ru/<username>?startapp=<test>
#   MAX_BOT_ID       — the bot's user_id for "Открыть приложение" buttons
#   MAX_API_URL      — MAX Bot API address (default https://platform-api2.max.ru)
MAX_BOT_USERNAME=
MAX_BOT_ID=
MAX_API_URL=
# Bot texts and buttons live in messages.json: edit it and run `docker compose up -d --build bot`.
# The site (nginx + frontend, image from Docker Hub, see WEB_IMAGE) starts together with the rest
# on http://127.0.0.1:8080; WEB_PORT changes the address.
# Local use only: DEV_MODE=true + WEB_DEV_LOGIN=true open the home page in a plain browser without MAX.
# NEVER on a server: DEV_MODE switches the sign-in check off.
# DEV_MODE=true
# WEB_DEV_LOGIN=true
# Run the MAX text bot? true / false. With false (or without MAX_BOT_TOKEN) the bot container just idles;
# the site and the API are not affected.
BOT_ENABLED=true
# Frontend image for the "web" profile (pulled from Docker Hub) and where nginx listens here.
WEB_IMAGE=ivan0n/max-test-mini-app-web:latest
WEB_PORT=127.0.0.1:8080
# Maximum age of MAX init_data and lifetime of our session, in seconds.
MAX_INIT_DATA_MAX_AGE=3600
AUTH_SESSION_TTL=86400
# Closed beta: MAX user IDs (user.id from window.WebApp.initData), comma-separated.
# Empty = the service is open to every MAX user. Example: BETA_USER_IDS=987654321,123456789
BETA_USER_IDS=
# Public origin of the site (no path). Share links become <PUBLIC_URL>/test/<code>: a page with
# a test preview for the chat that opens the mini app. Empty = share the raw max.ru deep link.
PUBLIC_URL=

# Task images: the s3 service in compose.yaml (SeaweedFS). Use long random values, for example
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# S3_ACCESS_KEY / S3_SECRET_KEY are set once: the storage keeps using the first values it started with.
# S3_ACCESS_KEY=replace-with-a-random-access-key
# S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=test-images
# Signs image links (/api/images/<id>?exp=...&sig=...). Changing it invalidates links already handed out.
# IMAGE_SIGNING_KEY=replace-with-a-long-random-signing-key
